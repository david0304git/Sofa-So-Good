<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/levelSelect"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_background"
    tools:context=".LevelSelectActivity">

    <!-- Overlay 面板 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/settings_panel"
        android:padding="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 標題 -->
        <com.speed.sofasogood.OutlinedTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Levels"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <!-- 翻頁區域 -->
        <ViewFlipper
            android:id="@+id/viewFlipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 第一頁: 關卡 1-4 -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="true"
                android:alignmentMode="alignBounds"
                android:layout_gravity="center">

                <com.speed.sofasogood.OutlinedTextButton
                    android:id="@+id/btnLevel1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:background="@drawable/level_cell"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

                <com.speed.sofasogood.OutlinedTextButton
                    android:id="@+id/btnLevel2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:background="@drawable/level_cell"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

                <com.speed.sofasogood.OutlinedTextButton
                    android:id="@+id/btnLevel3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:background="@drawable/level_cell"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

                <com.speed.sofasogood.OutlinedTextButton
                    android:id="@+id/btnLevel4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:background="@drawable/level_cell"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

            </GridLayout>

            <!-- 第二頁: 關卡 5-8 -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="true"
                android:alignmentMode="alignBounds"
                android:layout_gravity="center">

                <com.speed.sofasogood.OutlinedTextButton
                    android:id="@+id/btnLevel5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:background="@drawable/level_cell"
                    android:text="5"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

                <com.speed.sofasogood.OutlinedTextButton
                    android:id="@+id/btnLevel6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:background="@drawable/level_cell"
                    android:text="6"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

                <com.speed.sofasogood.OutlinedTextButton
                    android:id="@+id/btnLevel7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:background="@drawable/level_cell"
                    android:text="7"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

                <com.speed.sofasogood.OutlinedTextButton
                    android:id="@+id/btnLevel8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:background="@drawable/level_cell"
                    android:text="8"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

            </GridLayout>

        </ViewFlipper>

        <!-- 箭頭導航 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/btnPrevPage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_left"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:layout_marginEnd="32dp"
                android:visibility="invisible"/>

            <ImageButton
                android:id="@+id/btnNextPage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_right"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:layout_marginStart="32dp"/>

        </LinearLayout>

        <!-- 返回 -->
        <com.speed.sofasogood.OutlinedTextButton
            android:id="@+id/btnBack"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Back"
            style="@style/NeonButton"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
