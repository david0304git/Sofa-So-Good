<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/levelSelect"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_background"
    tools:context=".activities.LevelSelectActivity">

    <!-- Extra Contexts 按鈕 -->
    <com.speed.sofasogood.views.OutlinedTextButton
        android:id="@+id/btnExtraContexts"
        style="@style/NeonButton"
        android:layout_width="310dp"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:text="@string/title_extra_contexts"
        app:layout_constraintBottom_toTopOf="@id/levelPanel"
        app:layout_constraintEnd_toEndOf="@id/levelPanel"
        app:layout_constraintStart_toStartOf="@id/levelPanel" />

    <!-- Main panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/levelPanel"
        android:layout_width="364dp"
        android:layout_height="576dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/ui_panel_levelselect"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.62"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintWidth_percent="0.84">

        <!-- Title -->
        <com.speed.sofasogood.views.OutlinedTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/title_levels"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Leaderboard -->
        <ImageButton
            android:id="@+id/btnLeaderboard"
            android:layout_width="214dp"
            android:layout_height="57dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ui_btnleaderboard_levelselect_eng"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <!-- Back -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="30dp"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/ui_btnback_levelselect_eng"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Arrow navigation -->
        <LinearLayout
            android:id="@+id/navRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/btnPrevPage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_left"
                android:visibility="invisible"
                tools:ignore="ImageContrastCheck" />

            <ImageButton
                android:id="@+id/btnNextPage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="32dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/next"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_right"
                tools:ignore="ImageContrastCheck" />
        </LinearLayout>

        <!-- Dynamic pages will be added in Java -->
        <ViewFlipper
            android:id="@+id/viewFlipper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:animateFirstView="false"
            app:layout_constraintBottom_toTopOf="@id/navRow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnLeaderboard" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
