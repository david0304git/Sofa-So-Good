<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/levelResult"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pause_overlay">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/settings_panel"
        android:padding="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 疲累角色 -->
        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:adjustViewBounds="true"
            android:src="@drawable/character_tired"
            android:layout_marginBottom="16dp"/>

        <!-- 通關文字 -->
        <com.speed.sofasogood.OutlinedTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level Complete!"
            android:textSize="26sp"
            android:textStyle="italic"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <!-- 下一關 -->
        <com.speed.sofasogood.OutlinedTextButton
            android:id="@+id/btnNextLevel"
            style="@style/NeonButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="Next Level"
            android:layout_marginBottom="12dp"/>

        <!-- 退出 -->
        <com.speed.sofasogood.OutlinedTextButton
            android:id="@+id/btnExit"
            style="@style/NeonButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="Exit"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
