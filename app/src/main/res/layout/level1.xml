<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/level1Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/level1_background">

    <!-- 暫停按鈕 -->

    <!-- 遊戲畫面 -->

    <com.speed.sofasogood.views.OutlinedTextView
        android:id="@+id/levelTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="68dp"
        android:elevation="10dp"
        android:text="0:00.00"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 跳過按鈕 -->
    <ImageButton
        android:id="@+id/btnSkip"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/dialog_box"
        android:elevation="10dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_media_next"
        app:layout_constraintEnd_toStartOf="@id/btnPause"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnPause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/dialog_box"
        android:elevation="10dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_media_pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.speed.sofasogood.game.GameView
        android:id="@+id/gameView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 劇情：角色 (貼底部，對話框下一層) -->
    <ImageView
        android:id="@+id/dialogCharacter"
        android:layout_width="300dp"
        android:layout_height="370dp"
        android:layout_marginStart="4dp"
        android:adjustViewBounds="true"
        android:src="@drawable/character_happy"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 劇情：對話框 -->
    <TextView
        android:id="@+id/dialogBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:background="@drawable/dialog_box"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:text=""
        android:textColor="#333333"
        android:textSize="20sp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 暫停 Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pauseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pause_overlay"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">

        <com.speed.sofasogood.views.OutlinedTextView
            android:id="@+id/pauseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_paused"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/pauseButtons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/pauseButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.speed.sofasogood.views.OutlinedTextButton
                android:id="@+id/btnResume"
                style="@style/NeonButton"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_resume"
                android:layout_marginBottom="16dp"/>

            <com.speed.sofasogood.views.OutlinedTextButton
                android:id="@+id/btnRestart"
                style="@style/NeonButton"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_restart"
                android:layout_marginBottom="16dp"/>

            <com.speed.sofasogood.views.OutlinedTextButton
                android:id="@+id/btnExit"
                style="@style/NeonButton"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_exit"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
